# Optional environment defaults for wasabi-universal-backup
# Copy to .env and adjust as needed.

# Remote and bucket
WUB_REMOTE="wasabi-ferber"
WUB_BUCKET="ferber-storage"

# Logging
WUB_LOG_DIR="$HOME/Logs"

# Concurrency
WUB_TRANSFERS="8"
WUB_CHECKERS="16"

# Bandwidth limit example: 10M, 0 means unlimited
WUB_BWLIMIT=""
